{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mscurechain-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mscurechain-frontend"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "/api/proxy",
    "BACKEND_INTERNAL_URL": "https://mscurechain-backend-latest-production.up.railway.app/api",
    "NEXT_PUBLIC_SUPPORT_DASHBOARD_URL": "https://curechain-report-system.vercel.app"
  }
}

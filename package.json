{
  "name": "frontend",
  "version": "1.0.8",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:fast": "NEXT_DISABLE_SOURCEMAPS=1 next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:standalone": "npm run build && node -e \"const fs = require('fs'); fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive: true}); fs.cpSync('public', '.next/standalone/public', {recursive: true});\"",
    "electron:build": "npm run build:standalone && electron-builder --win --x64 --publish never",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "build:worker": "cross-env NODE_OPTIONS=--max-old-space-size=4096 opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview:worker": "wrangler dev",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:prod": "next build && next start",
    "tauri": "tauri",
    "desktop": "electron electron-main.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "@types/crypto-js": "^4.2.2",
    "@types/nprogress": "^0.2.3",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.27.5",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.14",
    "nprogress": "^0.2.0",
    "react": "^19.0.0",
    "react-advanced-cropper": "^0.20.1",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.18",
    "react-to-print": "^3.2.0",
    "recharts": "^3.6.0",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.5",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^1.8.29",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "build": {
    "appId": "com.mscurechain.hospital",
    "productName": "MSCureChain",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      ".next/standalone/**/*",
      "public/**/*",
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "src-tauri/icons/icon.ico",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mstechhived1-design",
        "repo": "Mscurechain-Frontend-Latest"
      }
    ]
  }
}
